# ==============================================================================
# 🛡️ SecOps Guardian - Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database & Persistence Layer
# ------------------------------------------------------------------------------
# Target production PostgreSQL database URL.
# If omitted or unavailable in dev/test, SecOps Guardian automatically falls back to SQLite.
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/secops_guardian

# ------------------------------------------------------------------------------
# 2. Authentication, RBAC & Secret Encryption
# ------------------------------------------------------------------------------
# Enforces strict API Key / JWT header verification on all /api/scan/* and /api/verify/* routes.
# Set to 'false' in local dev/testing for automatic fallback to default test org.
SECOPS_REQUIRE_AUTH=false

# 32-byte URL-safe base64-encoded key used for Fernet symmetric encryption of SSO client secrets.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECOPS_ENCRYPTION_KEY=YOUR_FERNET_ENCRYPTION_KEY_HERE

# Secret key used for signing JWT session tokens issued after SSO or API-key exchanges.
SECOPS_JWT_SECRET=super-secret-jwt-signing-key-change-in-production-min-32-chars

# Token lifetime in hours (default: 24)
SECOPS_JWT_EXPIRATION_HOURS=24

# Base URL used for constructing SAML SP metadata and OAuth redirect callbacks.
SECOPS_BASE_URL=http://localhost:8000

# ------------------------------------------------------------------------------
# 3. AI Remediation Engine (Gemini)
# ------------------------------------------------------------------------------
# API Key for Google Gemini 2.5 Flash used in generating remediation patches and executive summaries.
GEMINI_API_KEY=your_gemini_api_key_here

# ------------------------------------------------------------------------------
# 4. Feature 1: GitHub App Auto-PR Remediation
# ------------------------------------------------------------------------------
# GitHub App ID from GitHub Developer Settings
GITHUB_APP_ID=123456

# GitHub App Private Key (.pem file path or raw multiline PEM string)
GITHUB_PRIVATE_KEY=./secrets/secops-guardian.private-key.pem

# GitHub App URL slug used for installation links (https://github.com/apps/{slug}/installations/new)
GITHUB_APP_SLUG=secops-guardian

# Webhook secret configured on the GitHub App for verifying X-Hub-Signature-256
GITHUB_WEBHOOK_SECRET=your_github_webhook_secret_here

# ------------------------------------------------------------------------------
# 5. Feature 2: Email Alerting (SMTP)
# ------------------------------------------------------------------------------
# SMTP credentials for sending automated security notifications on CI/CD deploy scans.
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_USER=postmaster@yourdomain.com
SMTP_PASSWORD=your_smtp_password_here
SMTP_FROM=alerts@secopsguardian.io
